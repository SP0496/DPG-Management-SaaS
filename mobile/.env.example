# ==============================================================================
# React Native (Expo) Environment Configuration Template
# EXPO_PUBLIC_* variables are exposed to the client bundle at build time.
# NEVER PUT PRIVATE API KEYS, DATABASE PASSWORDS, OR SIGNING SECRETS HERE!
# ==============================================================================

# Backend API Base URL
# For Android Emulator: http://10.0.2.2:8080/api/v1
# For iOS Simulator: http://localhost:8080/api/v1
# For Physical Device (same Wi-Fi): http://<YOUR_LOCAL_IP>:8080/api/v1
# For Production: https://api.pgmanagement.com/api/v1
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api/v1
EXPO_PUBLIC_APP_ENV=development
