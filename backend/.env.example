SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

DB_HOST=localhost
DB_PORT=5432
DB_NAME=pg_management_db
DB_USER=pg_admin
DB_PASSWORD=change_this_to_a_strong_password_in_production
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=5

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_this_to_a_strong_redis_password

