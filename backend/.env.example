# ==============================================================================
# Spring Boot Backend Environment Configuration Template
# Set these environment variables before starting the Spring Boot server.
# ==============================================================================

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

DB_HOST=localhost
DB_PORT=5432
DB_NAME=pg_management_db
DB_USER=pg_admin
DB_PASSWORD=
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2

# Minimum 512-bit Base64 secret for HMAC-SHA512 JWT signing (openssl rand -base64 64)
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Firebase Admin SDK Configuration (provide path OR raw/base64 JSON)
FIREBASE_AUTH_ENABLED=true
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Comma-separated backend-controlled +91 E.164 phone numbers allowed automatic OWNER provisioning
OWNER_ALLOWLIST_PHONES=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://10.0.2.2:8080
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_GENERAL_PER_MINUTE=120
