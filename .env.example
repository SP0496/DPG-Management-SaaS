# ==============================================================================
# PG-Management-SaaS Root Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN REAL VALUES FOR LOCAL DEVELOPMENT
# NEVER COMMIT THE ACTUAL .env FILE TO VERSION CONTROL
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_DEBUG=false

# Spring Boot Backend Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pg_management_db
DB_USER=pg_admin
DB_PASSWORD=change_this_to_a_strong_password_in_production
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=5

# Redis Cache & Rate Limiting
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_this_to_a_strong_redis_password

# Authentication & JWT Security (Min 256-bit / 32-byte secret for HS256/HS512)
# Generate via: openssl rand -base64 64
JWT_SECRET=dGhpcy1pcy1hLXZlcnktc2VjdXJlLTI1Ni1iaXQtand0LXNlY3JldC1rZXktZm9yLWRldmVsb3BtZW50LW9ubHktZ2VuZXJhdGUtbmV3LWluLXByb2Q=
JWT_ACCESS_EXPIRATION_MS=900000        # 15 minutes
JWT_REFRESH_EXPIRATION_MS=604800000    # 7 days

# CORS Allowed Origins (Comma-separated)
# In production, specify exact origin e.g. https://app.pgmanagement.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://10.0.2.2:8080

# Rate Limiting Parameters (Requests per minute)
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_GENERAL_PER_MINUTE=60

# Mobile Application (React Native)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api/v1
EXPO_PUBLIC_APP_ENV=development
