# ==============================================================================
# PG-Management-SaaS Root Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN REAL SECRETS FOR LOCAL DEVELOPMENT
# NEVER COMMIT .env TO VERSION CONTROL
# ==============================================================================

APP_ENV=development
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pg_management_db
DB_USER=pg_admin
DB_PASSWORD=
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2

# JWT Security (Minimum 512-bit Base64 secret recommended for HS512)
# Generate locally with: openssl rand -base64 64
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma-separated exact origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://10.0.2.2:8080

# Firebase Admin SDK & Owner Phone Allowlist
FIREBASE_AUTH_ENABLED=true
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=D:\DPG-Management-SaaS\secrets\firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=
OWNER_ALLOWLIST_PHONES=

# Rate Limiting (Requests per minute per client IP)
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_GENERAL_PER_MINUTE=120

# Mobile Application (React Native Android)
# Use http://10.0.2.2:8080/api/v1 for Android Emulator
# Use http://<YOUR_PC_LAN_IP>:8080/api/v1 for a physical Android phone on Wi-Fi
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api/v1
EXPO_PUBLIC_APP_ENV=development
